# Local development and Vercel backend environment template.
# Use a managed PostgreSQL connection string; do not commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PORT=5000

# Comma-separated exact frontend origins. Use the frontend Vercel URL in production.
CORS_ORIGIN="http://localhost:5173"

# Generate a unique value with at least 32 characters in production.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Used only by the separate post-deploy seed command.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
