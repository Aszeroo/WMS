generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EquipmentType {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  unit        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  instances   EquipmentInstance[]

  @@index([name])
}

model EquipmentInstance {
  id           Int                 @id @default(autoincrement())
  serialNumber String              @unique
  brand        String?
  model        String?
  purchaseDate DateTime?
  status       String              @default("available")
  typeId       Int
  type         EquipmentType       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  issuances    EquipmentIssuance[]
  repairs      EquipmentRepair[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([typeId])
  @@index([serialNumber])
}

model Employee {
  id         Int                 @id @default(autoincrement())
  employeeId String              @unique
  name       String
  department String?
  position   String?
  issuances  EquipmentIssuance[]
  repairs    EquipmentRepair[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([name])
}

model EquipmentIssuance {
  id          Int               @id @default(autoincrement())
  equipmentId Int
  employeeId  Int
  issueDate   DateTime          @default(now())
  returnDate  DateTime?
  dueDate     DateTime?
  building    String?
  floor       String?
  jobNumber   String?
  notes       String?
  equipment   EquipmentInstance @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([equipmentId, returnDate])
  @@index([issueDate])
  @@index([jobNumber])
  @@index([dueDate])
}

model EquipmentRepair {
  id          Int               @id @default(autoincrement())
  equipmentId Int
  employeeId  Int?
  repairDate  DateTime          @default(now())
  symptoms    String
  status      String            @default("reported")
  repairedBy  String?
  notes       String?
  equipment   EquipmentInstance @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  employee    Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([equipmentId, status])
  @@index([employeeId])
  @@index([repairDate])
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  role           String   @default("viewer")
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  auditLogs      AuditLog[] @relation("AuditLogUser")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  action       String   // e.g., "CREATE_EQUIPMENT", "UPDATE_USER", "DELETE_ISSUANCE"
  entityType   String   // e.g., "EquipmentInstance", "User", "EquipmentIssuance"
  entityId     Int?     // ID of the affected entity (can be null if entity was deleted)
  userId       Int      // ID of the user who performed the action
  user         User     @relation("AuditLogUser", fields: [userId], references: [id])
  timestamp    DateTime @default(now())
  changes      Json     // Store the changes made (as JSON object)
  ipAddress    String?  // IP address of the user (optional)
  userAgent    String?  // User agent string (optional)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}
