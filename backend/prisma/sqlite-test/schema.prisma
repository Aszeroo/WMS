generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EquipmentType {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  unit        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  instances   EquipmentInstance[]

  @@index([name])
}

model EquipmentInstance {
  id           Int                 @id @default(autoincrement())
  serialNumber String              @unique
  brand        String?
  model        String?
  purchaseDate DateTime?
  status       String              @default("available")
  typeId       Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  type         EquipmentType       @relation(fields: [typeId], references: [id])
  issuances    EquipmentIssuance[]
  repairs      EquipmentRepair[]

  @@index([status])
  @@index([typeId])
  @@index([serialNumber])
}

model Employee {
  id         Int                 @id @default(autoincrement())
  employeeId String              @unique
  name       String
  department String?
  position   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  issuances  EquipmentIssuance[]
  repairs    EquipmentRepair[]

  @@index([name])
}

model EquipmentIssuance {
  id          Int               @id @default(autoincrement())
  equipmentId Int
  employeeId  Int
  issueDate   DateTime          @default(now())
  returnDate  DateTime?
  building    String?
  floor       String?
  jobNumber   String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  employee    Employee          @relation(fields: [employeeId], references: [id])
  equipment   EquipmentInstance @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, returnDate])
  @@index([issueDate])
  @@index([jobNumber])
}

model EquipmentRepair {
  id          Int               @id @default(autoincrement())
  equipmentId Int
  employeeId  Int?
  repairDate  DateTime          @default(now())
  symptoms    String
  status      String            @default("reported")
  repairedBy  String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  employee    Employee?         @relation(fields: [employeeId], references: [id])
  equipment   EquipmentInstance @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, status])
  @@index([employeeId])
  @@index([repairDate])
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  email          String     @unique
  passwordHash   String
  role           String     @default("viewer")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessionVersion Int        @default(0)
  auditLogs      AuditLog[] @relation("AuditLogUser")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userId     Int
  timestamp  DateTime @default(now())
  changes    Json
  ipAddress  String?
  userAgent  String?
  user       User     @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}
