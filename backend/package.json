{
  "name": "equipment-management-backend",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "vercel-build": "prisma generate && prisma migrate deploy && tsc",
    "start": "node dist/server.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=\"file:./test.db\" NODE_ENV=test prisma migrate deploy --schema prisma/sqlite-test/schema.prisma && DATABASE_URL=\"file:./test.db\" NODE_ENV=test prisma generate --schema prisma/sqlite-test/schema.prisma && DATABASE_URL=\"file:./test.db\" NODE_ENV=test vitest run --pool=forks",
    "test:watch": "DATABASE_URL=\"file:./test.db\" NODE_ENV=test vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
